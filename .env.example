# Copy to .env for local development. Do not commit .env or real credentials.

# Provider and model are intentionally unset until an implementation is selected.
DESKTOP_AGENT_MODEL_PROVIDER=
DESKTOP_AGENT_MODEL_NAME=
DESKTOP_AGENT_MODEL_BASE_URL=
DESKTOP_AGENT_MODEL_API_KEY=

# Comma-separated absolute paths the future read-only tools may inspect.
# Keep this allowlist narrow; an empty value should mean no filesystem access.
DESKTOP_AGENT_READ_ROOTS=

# Local audit log directory. The future implementation should use a private,
# user-owned directory and redact secrets before recording any event.
DESKTOP_AGENT_AUDIT_DIR=

# Maximum time to wait for an explicit human decision on a proposed write.
# Timeout, dismissal, or denial must reject the action.
DESKTOP_AGENT_APPROVAL_TIMEOUT_SECONDS=120
